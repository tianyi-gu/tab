{
  "name": "@tabmagic/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tabmagic/core": "0.1.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "plasmo": "^0.89.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.3"
  },
  "manifest": {
    "name": "TabMagic",
    "description": "Local-first tab stash, snooze, and automation manager.",
    "version": "0.1.0",
    "permissions": [
      "tabs",
      "tabGroups",
      "storage",
      "alarms",
      "notifications",
      "commands",
      "contextMenus",
      "sidePanel"
    ],
    "commands": {
      "stash-current-tab": {
        "suggested_key": {
          "default": "Ctrl+Shift+S",
          "mac": "Command+Shift+S"
        },
        "description": "Stash current tab"
      }
    }
  }
}
